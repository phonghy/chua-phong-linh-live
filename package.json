{
  "name": "chua-phong-linh-live",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/src/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "benchmark": "TEMPLE_BENCHMARK=1 playwright test tests/e2e/benchmark.spec.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write 'apps/**/*.{ts,tsx,css,json,html}' 'packages/**/*.{ts,json}' 'tests/**/*.ts' 'scripts/*.mjs' playwright.config.ts",
    "package": "bun scripts/build-desktop.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@fontsource/lora": "^5.2.8",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "phaser": "4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "optionalDependencies": {
    "tiktok-live-connector": "^2.1.0"
  }
}
